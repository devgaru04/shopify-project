# Puerto donde correrá el backend
PORT=4000

# Nombre de la tienda Shopify, por ejemplo: tu-tienda
SHOP=your-shop-name

# Token de Storefront API para consumir productos y checkout
STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Credenciales de la Custom App de Shopify para OAuth y Admin API
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# Permisos solicitados para la app
SCOPES=write_customers,read_customers,write_discounts

# URL de redirección usada por OAuth
OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/callback

# Versión de la API de Shopify a usar
API_VERSION=2024-10

# Token de Admin API. Se usa para operaciones sensibles como descuentos y clientes
SHOPIFY_ADMIN_ACCESS_TOKEN=
